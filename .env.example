# --- The Signal Desk (daily drafts into Notion) ---

# Notion internal integration token. Starts with "ntn_".
# See README, section "Connecting Notion", for exactly where to click.
NOTION_API_KEY=

# The three database IDs from the Signal Desk page in Notion.
# The ID is the 32-character string in the database URL.
NOTION_QUEUE_DB_ID=f97c58d06d7e43d88d0655de595e76e1
NOTION_JOURNAL_DB_ID=a5f8d48c3fed4fb59a10b75d42a93f1b
NOTION_LOG_DB_ID=eb7976ee86a44916a449f93c13ff1c4e
NOTION_DAILY_DB_ID=2b78f8ca03b145c6a18edbd9bb7374ba

# --- The morning ENGAGE run (comment targets into the Daily Plan) ---
#
# Both are read-only app credentials, not logins. Neither can post, comment or
# vote, and that is the only permission level this repo should ever hold.
#
# Reddit: create a free app at https://www.reddit.com/prefs/apps
#   Choose "script". Name it anything. Redirect URI can be http://localhost.
#   CLIENT_ID is the short string under the app name, SECRET is next to "secret".
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Product Hunt: https://www.producthunt.com/v2/oauth/applications
#   Create an application, then "Create developer token".
PRODUCTHUNT_TOKEN=

# LinkedIn and X are deliberately absent and there is nothing to fill in.
# Both require an authenticated session to read a feed, both forbid automated
# reading in their terms, and LinkedIn bans accounts for it. Those two channels
# stay manual on purpose.

# At least one model key. Anthropic is used when both are present.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4o
OPENROUTER_MODEL=openai/gpt-4o

# --- Superseded weekly email workflow ---
# Only needed if you run `npm run weekly`. Not used by the daily run.
RESEND_API_KEY=
EMAIL_FROM=UX Intelligence Engine <weekly@yourdomain.com>
EMAIL_TO=alifnoushad.96@gmail.com
